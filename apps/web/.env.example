# Forge Sites — server environment.
# Copy to .env.local and fill in. Validated by Zod at boot (lib/env/schema.ts):
# production refuses to start with anything missing; development warns.

# --- App ---------------------------------------------------------------------
APP_URL=http://localhost:3000

# --- Database (Supabase Postgres) ---------------------------------------------
# Serverless runtime: use the transaction-pooler URL (port 6543).
# drizzle-kit migrate: use the direct URL (port 5432).
DATABASE_URL=postgres://postgres:password@db.xxxx.supabase.co:6543/postgres

# --- Supabase (auth) -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (platform billing) --------------------------------------------------
# Annual prices are 10x monthly (2 months free). Create in the Stripe dashboard,
# paste IDs here — they are never hardcoded.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_STUDIO_MONTHLY=price_...
STRIPE_PRICE_STUDIO_ANNUAL=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_AGENCY_ANNUAL=price_...
# One-time overage pack; CREDIT_PACK_UNITS generations per pack.
STRIPE_PRICE_CREDIT_PACK=price_...
CREDIT_PACK_UNITS=100
# Custom-domain add-on (per-domain, wired in Phase 5).
STRIPE_PRICE_DOMAIN_ADDON=

# --- Upstash (rate limiting) — optional in dev, required in production ---------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Anthropic (Phase 3+) -------------------------------------------------------
ANTHROPIC_API_KEY=
MODEL_FREE=claude-haiku-4-5
MODEL_STANDARD=claude-sonnet-5
MODEL_COMPLEX=claude-opus-4-8

# --- RLS e2e proof (e2e/rls.spec.ts) — test users only, never production -------
RLS_TEST_USER_A_EMAIL=
RLS_TEST_USER_A_PASSWORD=
RLS_TEST_USER_B_EMAIL=
RLS_TEST_USER_B_PASSWORD=
