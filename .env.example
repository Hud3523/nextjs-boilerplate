# HERMES OMEGA INFINITY — connector credentials.
# Copy to .env.local (gitignored) and fill in. Never commit real secrets.
# All values are read server-side only and are never exposed to the browser.

# --- TradingView (Mathieu2301/Tradingview-API) ---
# Optional: only needed for premium/private data. Public quotes work without it.
# Get from the `sessionid` / `sessionid_sign` cookies of a logged-in TV session.
TV_SESSION=
TV_SIGNATURE=

# --- Polymarket via Bitquery (bitquery/polymarket-api) ---
# Required for the on-chain TRADES connector. Create a Bitquery account + token.
BITQUERY_OAUTH_TOKEN=
# Optional override (defaults to Bitquery EAP streaming endpoint):
# BITQUERY_ENDPOINT=https://streaming.bitquery.io/graphql

# --- Quant Desk (Polymarket edge scanner + TradingView signals) ---
# The edge scanner reads LIVE market prices from Polymarket's public Gamma API
# (no token needed). Override the base URL if desired:
# GAMMA_API=https://gamma-api.polymarket.com
# Code word that unlocks both quant bots (default: Money). Change this!
QUANT_CODE_WORD=Money

# --- OpenClaw runtime (openclaw/openclaw) ---
# Required: URL of your running OpenClaw service + its API key.
OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=
# Optional path overrides to match your deployment:
# OPENCLAW_HEALTH_PATH=/health
# OPENCLAW_STATUS_PATH=/status

# --- Hermes agent framework (nousresearch/hermes-agent) ---
# Required: URL of your running Hermes service + its API key.
HERMES_BASE_URL=
HERMES_API_KEY=
# Optional path overrides:
# HERMES_HEALTH_PATH=/health
# HERMES_MODELS_PATH=/v1/models
