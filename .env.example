# ── MISSION CONTROL configuration ───────────────────────────────────────────
# Copy this file to `.env` and fill in your values. The server reads it on boot.

# Your Anthropic API key. Without it the crew runs in clearly-labelled
# SIMULATION mode (drafts are templated, cost is $0) and a "needs-setup"
# blocker appears in the ATTENTION queue.
ANTHROPIC_API_KEY=

# Default model the crew runs on. See https://docs.claude.com for IDs.
# claude-opus-4-8 is the most capable; claude-haiku-4-5 is cheapest/fastest.
MODEL=claude-opus-4-8

# Hard budget cap in USD for real API spend. When today's spend reaches this,
# ALL agents are paused and a low-credit alert is raised. 0 disables the cap.
BUDGET_CAP_USD=5.00

# Starting simulated revenue (USD) shown on the status bar. Purely cosmetic —
# this is a command-center demo, not real accounting.
SEED_REVENUE_USD=1280.00

# ── Governance / recursion caps (a self-spawning org must be terminable) ─────
# Max floor tree depth, max agents per floor, max simultaneously-active floors.
MAX_FLOOR_DEPTH=3
MAX_AGENTS_PER_FLOOR=6
MAX_ACTIVE_FLOORS=8

# ── League / fund controls (Expansion III) ──────────────────────────────────
# Master fund cap (AUM) across ALL agencies — the top-level spend kill switch.
MASTER_FUND_CAP_USD=25
# Per-agency drawdown limit: an agency that loses this % of its capital is
# auto-paused / liquidated by the circuit breaker.
DRAWDOWN_PCT=50

# NOTE: the league defaults to DRY-RUN (zero real spend) on first launch. Arm
# live mode from the commissioner control room once ANTHROPIC_API_KEY is set.

# Backend port. The Vite dev server proxies /api and /events here.
PORT=4000
