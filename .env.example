# ── MISSION CONTROL — Hermes dashboard configuration ────────────────────────
# Copy to `.env`. This dashboard sits on top of your local Hermes Agent; it
# does NOT run its own agents. Hermes owns the agents/memory/tools.

# OpenRouter — Hermes calls models through this. The dashboard reads spend
# (and optionally your live credit balance) with this key.
OPENROUTER_API_KEY=

# How the dashboard reaches your local Hermes install:
#   mock = built-in sample agents (default; runs with no Hermes connected)
#   http = Hermes local HTTP gateway      (set HERMES_BASE_URL)
#   cli  = shell out to the `hermes` CLI  (set HERMES_CLI)
# Verify the exact endpoints/commands in server/src/hermes/index.ts against
# your Hermes docs, then flip the mode.
HERMES_MODE=mock
HERMES_BASE_URL=http://localhost:8787
HERMES_CLI=hermes

# Budget cap (USD). Displayed in the top bar; execution halts when reached.
BUDGET_CAP_USD=5

# ── Operator login (set before exposing publicly) ───────────────────────────
# When set, the dashboard requires this password. Blank = open local dev.
DASHBOARD_PASSWORD=
COOKIE_SECURE=false   # set true when serving over HTTPS
SESSION_SECRET=

# Backend port (the Vite dev server proxies /api and /events here).
PORT=4000
